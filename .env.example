# Database Config
DATABASE_URL=postgresql://postgres:1234@localhost:5432/lead_scraper

# Authentication Config
# Run 'openssl rand -hex 32' to generate a strong secret key
SECRET_KEY=yoursecretkeyhere
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Scraper Settings
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
SCRAPER_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=10
MAX_PAGES_PER_SITE=20
MAX_CRAWL_DEPTH=2

# Port/API Settings
PORT=8000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
